 kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
 %d128=index.constant 128 : index
 %has128=index.cmp uge,%lane,%d128 : index
 %lc128=view.load %scan[%zero,%lane] : view<2x256xi32> -> i32
 %le128=view.load %scan[%one,%lane] : view<2x256xi32> -> i32
 %pc128,%pe128=scf.if %has128 -> (i32,i32) {
  %prior128=index.sub %lane,%d128 : index
  %safe128=index.assume %prior128 [range(%prior128,0,255)] : index
  %c128=view.load %scan[%zero,%safe128] : view<2x256xi32> -> i32
  %e128=view.load %scan[%one,%safe128] : view<2x256xi32> -> i32
  scf.yield %c128,%e128 : i32,i32
 } else { scf.yield %i0,%i0 : i32,i32 }
 %nc128=scalar.addi %lc128,%pc128 : i32
 %ne128=scalar.ori %le128,%pe128 : i32
 kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
 view.store %nc128,%scan[%zero,%lane] : i32,view<2x256xi32>
 view.store %ne128,%scan[%one,%lane] : i32,view<2x256xi32>
 kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
 %inclusive=view.load %scan[%zero,%lane] : view<2x256xi32> -> i32
 scf.if %valid {
  %g=index.assume %lane [range(%lane,0,65)] : index
  %ov=buffer.view %offsets[%off] : buffer -> view<@BATCH@x66xi32>
  %exclusive=scalar.subi %inclusive,%count : i32
  view.store %exclusive,%ov[%b,%g] : i32,view<@BATCH@x66xi32>
 }
 %last=index.constant 65 : index
 %leader=index.cmp eq,%lane,%last : index
 scf.if %leader {
  %errors=view.load %scan[%one,%lane] : view<2x256xi32> -> i32
  %cap=scalar.constant @CAP@ : i32
  %overflow=scalar.cmpi ugt,%inclusive,%cap : i32
  %flag=scf.select %overflow,%i4,%i0 : i32
  %combined=scalar.ori %errors,%flag : i32
  %count_capped=scf.select %overflow,%cap,%inclusive : i32
  %sv=buffer.view %status[%off] : buffer -> view<@BATCH@x2xi32>
  view.store %combined,%sv[%b,%zero] : i32,view<@BATCH@x2xi32>
  view.store %count_capped,%sv[%b,%one] : i32,view<@BATCH@x2xi32>
 }
 kernel.return
}
