// Candidate metadata for CPU selection; landmark coordinates stay resident.
amdgpu.target<gfx11-generic> @target {subgroup_size = 32}
kernel.def target(@target) export("compact") @compact(%unused:index) {
  %one=index.constant 1 : index
  %threads=index.constant 256 : index
  %grid=index.constant @GRID@ : index
  kernel.launch.config workgroups(%grid,%one,%one) workgroup_size(%threads,%one,%one) : index
} launch(%unused:index,%input:buffer,%output:buffer) {
  %off=index.constant 0 : offset
  %threads=index.constant 256 : index
  %five=index.constant 5 : index
  %cap=index.constant @CAP@ : index
  %count=index.constant @COUNT@ : index
  %lane=kernel.workitem.id<x> : index
  %group=kernel.workgroup.id<x> : index
  %base=index.mul %group,%threads : index
  %raw=index.add %base,%lane : index
  %src=buffer.view %input[%off] : buffer -> view<@BATCH@x@CAP@x16xf32>
  %dst=buffer.view %output[%off] : buffer -> view<@COUNT@xf32>
  %valid=index.cmp ult,%raw,%count : index
  scf.if %valid {
    %i=index.assume %raw [range(%raw,0,@LAST@)] : index
    %colraw=index.rem %i,%five : index
    %col=index.assume %colraw [range(%colraw,0,4)] : index
    %row=index.div %i,%five : index
    %br=index.div %row,%cap : index
    %b=index.assume %br [range(%br,0,@LAST_BATCH@)] : index
    %rr=index.rem %row,%cap : index
    %r=index.assume %rr [range(%rr,0,@LAST_CAP@)] : index
    %value=view.load %src[%b,%r,%col] : view<@BATCH@x@CAP@x16xf32> -> f32
    view.store %value,%dst[%i] : f32,view<@COUNT@xf32>
  }
  kernel.return
}
